# myskin instance shell — copy to config.yaml per deployment.
# Secrets (API token, RAGFlow key, OIDC) live in .env only.
#
# Site/scraper config is stored in SQLite (api.registry_db) and managed via
# / or /api/sites. An optional `sites:` block below is imported only when
# the registry is empty (first boot). Existing DB rows are never overwritten
# from YAML on restart.
#
# OIDC (Keycloak) is instance-wide — not per scraper. When auth.enabled is true,
# the web UI at / uses session login; Bearer MYSKIN_API_TOKEN still works for API.

api:
  data_dir: ./data
  host: 0.0.0.0
  port: 8080
  registry_db: ./.myskin/sites.db
  # Fallback public URL when a site omits public_base_url:
  public_base_url: https://myskin.example.com

# server:
#   session_secret: ${SESSION_SECRET}
#   session_https_only: false  # TLS at nginx

# auth:
#   enabled: true
#   post_login_redirect: https://myskin.example.com/
#   # allowed_group: myskin-users  # optional Keycloak group gate
#   oidc:
#     issuer_url: https://keycloak.example.com/realms/master
#     client_id: myskin-dev
#     client_secret: ${OIDC_CLIENT_SECRET}
#     redirect_uri: https://myskin.example.com/auth/callback
#     scopes:
#       - openid
#       - profile
#       - email

# Default RAGFlow API URL used when creating a site that omits ragflow.api_url.
# Prefer setting api_url per scraper in the web UI (stored in the site registry).
ragflow:
  api_url: https://ragflow.example.com

# Optional first-boot seed only (imported when sites.db is empty).
# After that, edit scrapers in / — changes here are ignored.
#
# sites:
#   - id: example-site
#     name: Example site
#     enabled: true
#     public_base_url: https://example.myskin.example.com
#     crawler:
#       seed_url: https://example.com/
#       max_depth: 2
#       max_pages: 100
#       request_delay: 2.0
#       sitemap_only: true
#       html_to_markdown: true
#       passthrough:
#         enabled: true
#         extract_pdf_text: false
#     scheduler:
#       enabled: true
#       cron: "0 2 * * 0"
#       timezone: UTC
#     ragflow:
#       enabled: true
#       api_url: https://ragflow.example.com
#       dataset_id: ""
#       sync_on_crawl_complete: true
#       parse_on_upload: true
#       delete_missing: true
#
# Legacy single-site format (crawler:/scheduler:/ragflow: at root) is still
# imported into the registry on first startup when `sites:` is absent and the DB is empty.
